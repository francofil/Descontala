# URL del proyecto Supabase (local: http://127.0.0.1:54321 · nube: Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (sb_publishable_…). Se puede exponer al navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_…). SOLO servidor: se usa para que el admin cree usuarios merchant.
# Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
